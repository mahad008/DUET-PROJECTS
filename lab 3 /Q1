#include <iostream>
#define PI 3.14159

using namespace std;

int main() {
    double radius, area;

    // Ask user for radius
    cout << "Enter the radius of the circle: ";
    cin >> radius;

    // Calculate area
    area = PI * radius * radius;

    // Display the result
    cout << "The area of the circle is: " << area << endl;

    return 0;
}
