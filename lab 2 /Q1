#include <iostream>
using namespace std;

int main() {
    // Declare variables
    float a, b, result;

    // Get user input
    cout << "Enter the value of a: ";
    cin >> a;
    
    cout << "Enter the value of b: ";
    cin >> b;

    // Compute the expression (a + b)^2 = a^2 + 2ab + b^2
    result = (a * a) + (2 * a * b) + (b * b);

    // Output the result
    cout << "The result of (a + b)^2 is: " << result << endl;

    return 0;
}
