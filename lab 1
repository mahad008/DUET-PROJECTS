#include <iostream>
using namespace std;

int main() {
    double num1, num2, num3;

    // Input three numbers
    cout << "Enter three numbers: ";
    cin >> num1 >> num2 >> num3;

    // Addition
    double addition = num1 + num2 + num3;

    // Subtraction (in order)
    double subtraction = num1 - num2 - num3;

    // Multiplication
    double multiplication = num1 * num2 * num3;

    // Division (in order, avoid division by zero)
    double division;
    if (num2 != 0 && num3 != 0) {
        division = num1 / num2 / num3;
    } else {
        cout << "Division not possible (division by zero)." << endl;
        division = 0; // Just setting to 0 if division is not possible
    }

    // Average
    double average = (num1 + num2 + num3) / 3;

    // Display results
    cout << "Addition: " << addition << endl;
    cout << "Subtraction: " << subtraction << endl;
    cout << "Multiplication: " << multiplication << endl;
    if (num2 != 0 && num3 != 0) {
        cout << "Division: " << division << endl;
    }
    cout << "Average: " << average << endl;

    return 0;
}
