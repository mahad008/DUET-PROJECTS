#include <iostream> 
using namespace std; 
 
int main() { 
    char grade; 
 
    cout << "Enter student grades (A-E). Enter 'X' to exit.\n"; 
 
    while (true) { 
        cout << "\nEnter grade: "; 
        cin >> grade; 
 
        // Convert to uppercase for uniformity 
        grade = toupper(grade); 
 
        if (grade == 'X') { 
            cout << "Exiting program." << endl; 
            break; 
        } 
 
        // Switch statement to evaluate grade 
        switch (grade) { 
            case 'A': 
                cout << "Excellent!" << endl; 
                break; 
            case 'B': 
                cout << "Good!" << endl; 
                break; 
            case 'C': 
                cout << "Fair." << endl; 
                break; 
            case 'D': 
                cout << "Poor." << endl; 
                break; 
            case 'E': 
                cout << "Failed." << endl; 
                break; 
            default: 
                cout << "Invalid grade. Please enter A, B, C, D, E, or X to exit." << endl; 
        } 
    } 
 
    return 0; 
} 
