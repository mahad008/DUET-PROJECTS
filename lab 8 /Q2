#include <iostream>
using namespace std;

int main() {
    const int SIZE = 5;
    int marks[SIZE];
    int sum = 0;

    cout << "Enter marks of 5 students:\n";
    for (int i = 0; i < SIZE; ++i) {
        cin >> marks[i];
        sum += marks[i];
    }

    double average = sum / static_cast<double>(SIZE);
    cout << "Average marks: " << average << endl;

    return 0;
}
