#include <iostream>
using namespace std;

int main() {
    const int SIZE = 5;
    int arr1[SIZE] = {1, 2, 3, 4, 5};
    int arr2[SIZE] = {5, 4, 3, 2, 1};
    int sum[SIZE];

    for (int i = 0; i < SIZE; ++i)
        sum[i] = arr1[i] + arr2[i];

    cout << "Sum of arrays:\n";
    for (int i = 0; i < SIZE; ++i)
        cout << sum[i] << " ";

    cout << endl;
    return 0;
}
