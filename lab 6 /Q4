#include <iostream>
using namespace std;

int main() {
    int rows = 5;

    // Outer loop for each row
    for (int i = 1; i <= rows; ++i) {
        // Inner loop for printing numbers in each row
        for (int j = 1; j <= i; ++j) {
            cout << j;
        }
        cout << endl; // Move to the next line
    }

    return 0;
}
