#include <iostream>
using namespace std;

int main() {
    int n;

    // Prompt user for input
    cout << "Enter the number of terms in Fibonacci series: ";
    cin >> n;

    // Handle invalid input
    if (n <= 0) {
        cout << "Please enter a positive integer." << endl;
        return 1;
    }

    long long first = 0, second = 1, next;

    cout << "Fibonacci Series: ";

    for (int i = 1; i <= n; ++i) {
        cout << first << " ";

        next = first + second;
        first = second;
        second = next;
    }

    cout << endl;
    return 0;
}
